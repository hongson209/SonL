pub fn str_is_ascii(s: [u8]) -> bool {
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] >= 128 as u8) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn str_starts_with(s: [u8], prefix: [u8]) -> bool {
    if (prefix.len > s.len) {
        return false;
    }

    var i: usize = 0;
    while (i < prefix.len) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i = i + 1;
    }

    return true;
}

pub fn str_ends_with(s: [u8], suffix: [u8]) -> bool {
    if suffix.len > s.len {
        return false;
    }

    val offset = s.len - suffix.len;
    var i: usize = 0;
    while i < suffix.len {
        if s[offset + i] != suffix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn str_contains_char(s: [u8], target: u8) -> bool {
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] == target) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn str_find_char(s: [u8], target: u8) -> i64 {
    var i: usize = 0;
    while i < s.len {
        if s[i] == target {
            return i as i64;
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn str_parse_i32(s: [u8]) -> i32 {
    if s.len == 0 {
        return 0;
    }

    var is_neg = false;
    var start_idx: usize = 0;
    if s[0] == 45 as u8 { // '-'
        is_neg = true;
        start_idx = 1;
    }

    var result: i32 = 0;
    var i = start_idx;
    while i < s.len {
        val c = s[i];
        if c >= 48 as u8 && c <= 57 as u8 {
            val digit = (c - 48 as u8) as i32;
            result = result * 10 + digit;
        }
        i = i + 1;
    }

    if is_neg {
        return 0 - result;
    }
    return result;
}
