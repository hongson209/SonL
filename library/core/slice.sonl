pub fn slice_is_empty(s: [u8]) -> bool => s.len == 0;

pub fn slice_get(s: [u8], index: usize) -> u8 {
    if (index >= s.len) {
        return 0 as u8;
    }
    return s[index];
}

pub fn slice_equals(a: [u8], b: [u8]) -> bool {
    if (a.len != b.len) {
        return false;
    }

    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }

    return true;
}

pub fn slice_fill_u8(s: [u8], value: u8) -> void {
    var i: usize = 0;
    while i < s.len {
        s[i] = value;
        i = i + 1;
    }
}

pub fn slice_reverse_i32(s: [i32]) -> void {
    if s.len <= 1 {
        return;
    }

    var left: usize = 0;
    var right: usize = s.len - 1;

    while left < right {
        val tmp = s[left];
        s[left] = s[right];
        s[right] = tmp;

        left = left + 1;
        right = right - 1;
    }
}

pub fn slice_binary_search_i32(s: [i32], key: i32) -> i64 {
    if s.len == 0 {
        return 0 - 1;
    }

    var low: usize = 0;
    var high: usize = s.len - 1;

    while low <= high {
        val mid = low + (high - low) / 2;
        val mid_val = s[mid];

        if mid_val == key {
            return mid as i64;
        } else if mid_val < key {
            low = mid + 1;
        } else {
            if mid == 0 {
                return 0 - 1;
            }
            high = mid - 1;
        }
    }

    return 0 - 1;
}
