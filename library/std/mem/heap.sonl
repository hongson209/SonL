extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8) -> void;
    fn realloc(ptr: *mut u8, new_size: usize) -> *mut u8;
    fn memset(s: *mut u8, c: i32, n: usize) -> *mut u8;
    fn memcpy(dest: *mut u8, src: *const u8, n: usize) -> *mut u8;
}

pub fn alloc(size: usize, align: usize) -> *mut u8 {
    return malloc(size);
}

pub fn mem_free(ptr: *mut u8, size: usize) -> void {
    free(ptr);
}

pub fn mem_realloc(ptr: *mut u8, old_size: usize, new_size: usize) -> *mut u8 {
    return realloc(ptr, new_size);
}

pub fn mem_set(ptr: *mut u8, byte_val: i32, size: usize) -> *mut u8 {
    return memset(ptr, byte_val, size);
}

pub fn mem_copy(dest: *mut u8, src: *const u8, size: usize) -> *mut u8 {
    return memcpy(dest, src, size);
}
