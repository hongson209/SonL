pub fn swap_u16(v: u16) -> u16 {
    val b0: u16 = (v & 0xFF) << 8;
    val b1: u16 = (v >> 8) & 0xFF;
    return b0 | b1;
}

pub fn swap_u32(v: u32) -> u32 {
    val b0: u32 = (v & 0x000000FF) << 24;
    val b1: u32 = (v & 0x0000FF00) << 8;
    val b2: u32 = (v & 0x00FF0000) >> 8;
    val b3: u32 = (v & 0xFF000000) >> 24;
    return b0 | b1 | b2 | b3;
}

pub fn swap_i32(v: i32) -> i32 {
    val u: u32 = v as u32;
    val swapped: u32 = swap_u32(u);
    return swapped as i32;
}

pub fn to_be16(v: u16) -> u16 {
    return swap_u16(v);
}

pub fn to_be32(v: u32) -> u32 {
    return swap_u32(v);
}

pub fn to_be_i32(v: i32) -> i32 {
    return swap_i32(v);
}
