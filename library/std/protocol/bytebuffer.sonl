// SonLang Dynamic ByteBuffer
// Big-Endian binary serializing & deserializing engine for Minecraft, Game & Network protocols

import "library/std/mem/heap.sonl";
import "library/std/protocol/endian.sonl";
import "library/std/protocol/varint.sonl";

pub struct ByteBuffer {
    data: *mut u8,
    capacity: usize,
    read_pos: usize,
    write_pos: usize,
}

pub fn bytebuffer_new(initial_cap: usize) -> ByteBuffer {
    var cap = initial_cap;
    if cap == 0 {
        cap = 64;
    }
    val raw_ptr: *mut u8 = alloc(cap, 4);
    mem_set(raw_ptr, 0, cap);

    return ByteBuffer {
        data: raw_ptr,
        capacity: cap,
        read_pos: 0,
        write_pos: 0,
    };
}

pub fn bytebuffer_destroy(b: mut ref ByteBuffer) -> void {
    if b.capacity > 0 {
        mem_free(b.data, b.capacity);
        b.capacity = 0;
        b.read_pos = 0;
        b.write_pos = 0;
    }
}

pub fn bytebuffer_ensure_cap(b: mut ref ByteBuffer, additional: usize) -> void {
    if b.write_pos + additional > b.capacity {
        var new_cap = b.capacity * 2;
        while b.write_pos + additional > new_cap {
            new_cap = new_cap * 2;
        }
        b.data = mem_realloc(b.data, b.capacity, new_cap);
        b.capacity = new_cap;
    }
}

pub fn bytebuffer_write_u8(b: mut ref ByteBuffer, val_num: u8) -> void {
    bytebuffer_ensure_cap(b, 1);
    b.data[b.write_pos] = val_num;
    b.write_pos = b.write_pos + 1;
}

pub fn bytebuffer_read_u8(b: mut ref ByteBuffer) -> u8 {
    if b.read_pos >= b.write_pos {
        return 0 as u8;
    }
    val v = b.data[b.read_pos];
    b.read_pos = b.read_pos + 1;
    return v;
}

pub fn bytebuffer_write_i16_be(b: mut ref ByteBuffer, val_num: i16) -> void {
    bytebuffer_ensure_cap(b, 2);
    val u = val_num as u16;
    b.data[b.write_pos] = ((u >> 8) & 0xFF) as u8;
    b.data[b.write_pos + 1] = (u & 0xFF) as u8;
    b.write_pos = b.write_pos + 2;
}

pub fn bytebuffer_read_i16_be(b: mut ref ByteBuffer) -> i16 {
    if b.read_pos + 2 > b.write_pos {
        return 0 as i16;
    }
    val b0 = b.data[b.read_pos] as u16;
    val b1 = b.data[b.read_pos + 1] as u16;
    b.read_pos = b.read_pos + 2;
    val res = (b0 << 8) | b1;
    return res as i16;
}

pub fn bytebuffer_write_i32_be(b: mut ref ByteBuffer, val_num: i32) -> void {
    bytebuffer_ensure_cap(b, 4);
    val u = val_num as u32;
    b.data[b.write_pos] = ((u >> 24) & 0xFF) as u8;
    b.data[b.write_pos + 1] = ((u >> 16) & 0xFF) as u8;
    b.data[b.write_pos + 2] = ((u >> 8) & 0xFF) as u8;
    b.data[b.write_pos + 3] = (u & 0xFF) as u8;
    b.write_pos = b.write_pos + 4;
}

pub fn bytebuffer_read_i32_be(b: mut ref ByteBuffer) -> i32 {
    if b.read_pos + 4 > b.write_pos {
        return 0;
    }
    val b0 = b.data[b.read_pos] as u32;
    val b1 = b.data[b.read_pos + 1] as u32;
    val b2 = b.data[b.read_pos + 2] as u32;
    val b3 = b.data[b.read_pos + 3] as u32;
    b.read_pos = b.read_pos + 4;
    val res = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    return res as i32;
}

pub fn bytebuffer_write_varint(b: mut ref ByteBuffer, val_num: i32) -> void {
    var v = val_num as u32;
    while (v & 0xFFFFFF80) != 0 {
        val b_out = ((v & 0x7F) | 0x80) as u8;
        bytebuffer_write_u8(b, b_out);
        v = v >> 7;
    }
    bytebuffer_write_u8(b, (v & 0x7F) as u8);
}

pub fn bytebuffer_read_varint(b: mut ref ByteBuffer) -> i32 {
    var num_read: usize = 0;
    var result: u32 = 0;
    var read_next: bool = true;

    while read_next && b.read_pos < b.write_pos {
        val read_byte = bytebuffer_read_u8(b);
        val value = (read_byte & 0x7F) as u32;
        result = result | (value << (7 * num_read));
        num_read = num_read + 1;

        if (read_byte & 0x80) == 0 {
            read_next = false;
        } else if num_read >= 5 {
            return 0;
        }
    }
    return result as i32;
}

pub fn bytebuffer_len(b: ref ByteBuffer) -> usize => b.write_pos - b.read_pos;
