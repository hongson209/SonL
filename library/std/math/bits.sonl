// SonLang 64-bit Bitwise & Bit Manipulation Intrinsics
// Essential for Chunk bit-packing, block states, and compression

pub fn bswap16(v: u16) -> u16 => ((v >> 8) & 0xFF) | ((v & 0xFF) << 8);

pub fn bswap32(v: u32) -> u32 =>
    ((v >> 24) & 0xFF) |
    (((v >> 16) & 0xFF) << 8) |
    (((v >> 8) & 0xFF) << 16) |
    ((v & 0xFF) << 24);

pub fn bswap64(v: u64) -> u64 {
    val b0 = (v >> 56) & 0xFF;
    val b1 = ((v >> 48) & 0xFF) << 8;
    val b2 = ((v >> 40) & 0xFF) << 16;
    val b3 = ((v >> 32) & 0xFF) << 24;
    val b4 = ((v >> 24) & 0xFF) << 32;
    val b5 = ((v >> 16) & 0xFF) << 40;
    val b6 = ((v >> 8) & 0xFF) << 48;
    val b7 = (v & 0xFF) << 56;
    return b0 | b1 | b2 | b3 | b4 | b5 | b6 | b7;
}

pub fn extract_bits_u64(val_num: u64, offset: u32, count: u32) -> u64 {
    val mask = ((1 as u64) << count) - (1 as u64);
    return (val_num >> offset) & mask;
}
