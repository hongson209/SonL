pub struct Vec[T] {
    storage: [T],
    length: usize,
}

pub fn vec_new_i32(storage: [i32]) -> Vec[i32] => Vec {
    storage: storage,
    length: 0,
};

pub fn vec_push_i32(v: mut ref Vec[i32], item: i32) -> bool {
    if v.length >= v.storage.len {
        return false;
    }
    v.storage[v.length] = item;
    v.length = v.length + 1;
    return true;
}

pub fn vec_len_i32(v: ref Vec[i32]) -> usize => v.length;

pub fn vec_is_empty_i32(v: ref Vec[i32]) -> bool => v.length == 0;

pub fn vec_get_i32(v: ref Vec[i32], idx: usize) -> i32 {
    if idx >= v.length {
        return 0;
    }
    return v.storage[idx];
}

pub fn vec_pop_i32(v: mut ref Vec[i32]) -> i32 {
    if v.length == 0 {
        return 0;
    }
    v.length = v.length - 1;
    return v.storage[v.length];
}

pub fn vec_clear_i32(v: mut ref Vec[i32]) -> void {
    v.length = 0;
}

pub fn vec_contains_i32(v: ref Vec[i32], item: i32) -> bool {
    var i: usize = 0;
    while i < v.length {
        if v.storage[i] == item {
            return true;
        }
        i = i + 1;
    }
    return false;
}
