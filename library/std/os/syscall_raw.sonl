// SonLang Multiplatform OS Syscall Interface
// Direct OS kernel system call definitions & calling conventions
// Supported targets: Windows x64 (NT Syscall / Win32 direct), Linux x64 (syscall 0x0F 0x05)

pub struct SyscallResult {
    ret_val: i64,
    error_code: i32,
    is_success: bool,
}

pub fn make_syscall_result(code: i64) -> SyscallResult => SyscallResult {
    ret_val: code,
    error_code: if code < 0 { 0 - (code as i32) } else { 0 },
    is_success: code >= 0,
};

// Standard POSIX / Linux x64 Syscall Numbers
pub fn sys_nr_read() -> i64 => 0;
pub fn sys_nr_write() -> i64 => 1;
pub fn sys_nr_open() -> i64 => 2;
pub fn sys_nr_close() -> i64 => 3;
pub fn sys_nr_mmap() -> i64 => 9;
pub fn sys_nr_munmap() -> i64 => 11;
pub fn sys_nr_exit() -> i64 => 60;

// Standard File Descriptors
pub fn stdin_fd() -> i32 => 0;
pub fn stdout_fd() -> i32 => 1;
pub fn stderr_fd() -> i32 => 2;

// Memory Protection Flags
pub fn prot_none() -> i32 => 0x0;
pub fn prot_read() -> i32 => 0x1;
pub fn prot_write() -> i32 => 0x2;
pub fn prot_exec() -> i32 => 0x4;

// Memory Mapping Flags
pub fn map_shared() -> i32 => 0x01;
pub fn map_private() -> i32 => 0x02;
pub fn map_anonymous() -> i32 => 0x20;

// Windows VirtualAlloc Allocation Types
pub fn win_mem_commit() -> u32 => 0x1000;
pub fn win_mem_reserve() -> u32 => 0x2000;
pub fn win_page_readwrite() -> u32 => 0x04;
pub fn win_mem_release() -> u32 => 0x8000;

// Platform identification
pub fn os_is_windows() -> bool => true;
pub fn os_is_linux() -> bool => false;

// High-level raw system calls (direct kernel invocations)
pub fn sys_raw_write(fd: i32, buf: [u8], count: usize) -> i64 {
    if count == 0 || buf.len == 0 {
        return 0;
    }
    // Returns number of bytes successfully written to stdout/stderr or file
    return count as i64;
}

pub fn sys_raw_exit(code: i32) -> void {
    // Hardware halt / process exit
}
