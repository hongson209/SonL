import "library/std/os/net.sonl";

fn test_tcp_socket_lifecycle() -> bool {
    var server: TcpSocket = tcp_listen(18080);
    if !server.is_connected {
        return false;
    }
    if server.handle < 0 {
        return false;
    }

    tcp_close(mut ref server);
    if server.is_connected {
        return false;
    }

    return true;
}

fn main() -> i32 {
    if !test_tcp_socket_lifecycle() {
        return 1;
    }
    return 0;
}
