import "library/std/mem/heap.sonl";

fn test_pointer_indexing() -> bool {
    val raw: *mut u8 = alloc(16, 4);
    val ptr: *mut i32 = raw as *mut i32;

    ptr[0] = 100;
    ptr[1] = 200;
    ptr[2] = 300;

    if ptr[0] != 100 || ptr[1] != 200 || ptr[2] != 300 {
        return false;
    }

    mem_free(raw, 16);
    return true;
}

fn main() -> i32 {
    if !test_pointer_indexing() {
        return 1;
    }
    return 0;
}
