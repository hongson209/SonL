import "library/std/net/http.sonl";
import "library/std/encoding/json.sonl";

fn handle_client(req_bytes: [u8]) -> HttpResponse {
    val req = http_parse_request(req_bytes);
    if !req.is_valid {
        return http_response_not_found();
    }

    // Return JSON response
    val json_payload = "{\"status\": \"running\", \"engine\": \"SonLang\", \"code\": 200}";
    return http_response_ok(json_payload);
}

fn main() -> i32 {
    val incoming = "GET /status HTTP/1.1\r\nHost: localhost\r\n\r\n";
    val res = handle_client(incoming);

    if res.status_code != 200 {
        return 1;
    }

    val engine_tok = json_find_field(res.body, "engine");
    if engine_tok.kind != 7 { // String token
        return 2;
    }

    val code_tok = json_find_field(res.body, "code");
    if json_token_as_i32(res.body, code_tok) != 200 {
        return 3;
    }

    return 0;
}
