// Test suite for for-range loops, break, and continue
import "std/io.sonl";

fn main() -> i32 {
    var sum: i32 = 0;

    // Range loop 0..10: skip even numbers with continue, break at 7
    for i in 0..10 {
        if (i % 2) == 0 {
            continue;
        }
        if i > 7 {
            break;
        }
        sum = sum + i;
    }

    // Odd numbers <= 7: 1 + 3 + 5 + 7 = 16
    if sum != 16 {
        return 1;
    }

    // While loop with break and continue
    var w: i32 = 0;
    var acc: i32 = 0;
    while w < 20 {
        w = w + 1;
        if w == 3 {
            continue;
        }
        if w > 5 {
            break;
        }
        acc = acc + w;
    }

    // 1 + 2 + 4 + 5 = 12
    if acc != 12 {
        return 2;
    }

    return 0;
}
